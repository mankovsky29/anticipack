@page "/packing-activities"

<div class="page-container with-fixed-navbar">
    @if (_isLoading)
    {
        <div class="activities-skeleton" aria-label="@Localizer["Loading"]" aria-live="polite">
            @for (var i = 0; i < 4; i++)
            {
                <div class="skeleton-card">
                    <div class="skeleton-play"></div>
                    <div class="skeleton-content">
                        <div class="skeleton-line skeleton-title"></div>
                        <div class="skeleton-line skeleton-meta"></div>
                        <div class="skeleton-line skeleton-progress"></div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="sticky-header">
            <!-- Always visible search bar -->
            <div class="search-bar">
                <i class="fa fa-search search-icon"></i>
                <input type="text" 
                       class="search-input" 
                       placeholder="@Localizer["SearchPlaceholder"]" 
                       @bind="_searchTerm" 
                       @bind:event="oninput" />
                @if (!string.IsNullOrWhiteSpace(_searchTerm))
                {
                    <button class="search-clear-btn" @onclick="ClearSearch">
                        <i class="fa fa-times"></i>
                    </button>
                }
            </div>

            <!-- Filter Bar -->
            <div class="filter-bar">
                <div class="filter-chips">
                    <button class="filter-chip @(_archiveFilter == ArchiveFilterType.Active ? "active" : "")" 
                            @onclick="() => SetArchiveFilter(ArchiveFilterType.Active)">
                        <i class="fa fa-layer-group"></i>
                        <span>@Localizer["Active"]</span>
                    </button>
                    <button class="filter-chip @(_archiveFilter == ArchiveFilterType.Archived ? "active" : "")" 
                            @onclick="() => SetArchiveFilter(ArchiveFilterType.Archived)">
                        <i class="fa fa-archive"></i>
                        <span>@Localizer["Archived"]</span>
                    </button>
                </div>
            </div>
        </div>

        @if (_showOnboardingCard)
        {
            <section class="onboarding-card" role="region" aria-label="@Localizer["WelcomeTitle"]">
                <div class="onboarding-icon">
                    <i class="fa fa-route" aria-hidden="true"></i>
                </div>
                <div class="onboarding-content">
                    <h3>@Localizer["WelcomeTitle"]</h3>
                    <p>@Localizer["WelcomeDescription"]</p>
                    <div class="onboarding-actions">
                        <button class="btn primary" @onclick="AddNewActivityAsync">
                            <i class="fa fa-plus" aria-hidden="true"></i>
                            @Localizer["CreateActivity"]
                        </button>
                        <button class="btn cancel" @onclick="DismissOnboarding">@Localizer["Later"]</button>
                    </div>
                </div>
            </section>
        }
        
        @if (FilteredActivities.Any())
        {
            <div class="activities-list">
                @foreach (var activity in FilteredActivities)
                {
                    var itemCount = _activityItemCounts.GetValueOrDefault(activity.Id, 0);
                    var packedCount = _activityPackedCounts.GetValueOrDefault(activity.Id, 0);
                    var isCompleted = itemCount > 0 && packedCount == itemCount;
                    var progressPercent = itemCount > 0 ? (int)Math.Round((double)packedCount / itemCount * 100) : 0;

                    <div class="activity-card @(isCompleted ? "completed" : "") @(_openMenuId == activity.Id ? "menu-open" : "")">
                        <button class="btn-play" 
                                @onclick="() => OpenActivityInPackingMode(activity.Id)"
                                aria-label="@Localizer["PackNow"]"
                                title="@Localizer["PackNow"]">
                            <i class="fa @(isCompleted ? "fa-check" : "fa-play")"></i>
                        </button>

                        <div class="card-header">
                            <div class="header-content">
                                <div class="title-row">
                                    <h3 class="activity-title">@activity.Name</h3>
                                    <div class="title-badges">
                                        @if (isCompleted)
                                        {
                                            <span class="completed-badge" title="@Localizer["FullyPacked"]">
                                                <i class="fa fa-check-circle" aria-hidden="true"></i>
                                            </span>
                                        }
                                        @if (activity.IsShared)
                                        {
                                            <span class="shared-badge" title="@Localizer["SharedActivity"]">
                                                <i class="fa fa-share-alt"></i>
                                            </span>
                                        }
                                    </div>
                                </div>

                                <div class="activity-meta">
                                    <span class="meta-item">
                                        <i class="fa fa-clock"></i>
                                        @GetRelativeTime(activity.LastPacked)
                                    </span>
                                    <span class="meta-item">
                                        <i class="fa fa-box"></i>
                                        @(string.Format(Localizer["ItemsPacked"], packedCount, itemCount))
                                    </span>
                                </div>

                                @if (itemCount > 0)
                                {
                                    <div class="progress-bar-container" title="@progressPercent%">
                                        <div class="progress-bar-fill @(isCompleted ? "completed" : "")" style="width: @(progressPercent)%"></div>
                                    </div>
                                }
                                else
                                {
                                    <div class="progress-empty">@Localizer["NoItemsYet"]</div>
                                }
                            </div>
                            <div class="card-menu">
                                <button class="btn-menu" 
                                        @onclick="() => ToggleMenuAsync(activity.Id)"
                                        @onclick:stopPropagation
                                        aria-label="@Localizer["More"]"
                                        title="@Localizer["More"]">
                                    <i class="fa fa-ellipsis-v"></i>
                                </button>
                                @if (_openMenuId == activity.Id)
                                {
                                    <div class="menu-dropdown">
                                        <button class="menu-item" @onclick="() => OpenActivityInEditMode(activity.Id)">
                                            <i class="fa fa-edit"></i>
                                            <span>@Localizer["Edit"]</span>
                                        </button>
                                        <button class="menu-item" @onclick="() => ToggleArchiveActivity(activity)">
                                            <i class="fa @(activity.IsArchived ? "fa-box-open" : "fa-archive")"></i>
                                            <span>@(activity.IsArchived ? Localizer["Unarchive"] : Localizer["Archive"])</span>
                                        </button>
                                        <button class="menu-item danger" @onclick="() => PromptDeleteActivity(activity)">
                                            <i class="fa fa-trash"></i>
                                            <span>@Localizer["Delete"]</span>
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="no-activities">
                <div class="empty-icon">
                    <i class="fa fa-luggage-cart"></i>
                </div>
                <h3>@Localizer["NoActivities"]</h3>
                <p>@Localizer["NoActivitiesDescription"]</p>
                <button class="btn primary" @onclick="AddNewActivityAsync">
                    <i class="fa fa-plus"></i> @Localizer["CreateActivity"]
                </button>
            </div>
        }
        
        <!-- Scroll to Top Button -->
        @if (_showScrollToTop)
        {
            <button class="scroll-to-top-fab" @onclick="ScrollToTopAsync" aria-label="@Localizer["ScrollToTop"]" title="@Localizer["ScrollToTop"]">
                <i class="fa fa-arrow-up"></i>
            </button>
        }
        
        <button class="add-fab" @onclick="AddNewActivityAsync" aria-label="@Localizer["AddActivity"]" title="@Localizer["AddActivity"]">
            <i class="fa fa-plus"></i>
        </button>
    }
</div>