@page "/statistics"

<div class="page-container with-fixed-navbar">
    @if (_isLoading)
    {
        <div class="loading">
            <div class="loading-spinner"></div>
            <span>@Localizer["Loading"]</span>
        </div>
    }
    else if (_insights is not null)
    {
        <div class="insights-page">
            <!-- Personal summary -->
            @if (_insights.HasHistory)
            {
                <section class="summary-grid">
                    <div class="summary-tile">
                        <div class="summary-value">@_insights.TripsThisYear</div>
                        <div class="summary-label">@Localizer["TripsThisYear"]</div>
                    </div>
                    @if (_insights.PackingTimeThisYear > TimeSpan.Zero)
                    {
                        <div class="summary-tile">
                            <div class="summary-value">@PackingDurationFormatter.Format(_insights.PackingTimeThisYear, Localizer)</div>
                            <div class="summary-label">@Localizer["PackingTimeThisYear"]</div>
                        </div>
                    }
                    @if (_insights.GoToList is not null)
                    {
                        <button class="summary-tile summary-tile-wide" @onclick="() => OpenForPacking(_insights.GoToList)">
                            <div class="summary-label">@Localizer["GoToList"]</div>
                            <div class="summary-name">@_insights.GoToList.Name</div>
                            <div class="summary-detail">@string.Format(Localizer["GoToListTrips"], _insights.GoToListTrips)</div>
                        </button>
                    }
                </section>
            }
            else
            {
                <div class="insights-hint">
                    <i class="fa fa-info-circle" aria-hidden="true"></i>
                    <p>@Localizer["InsightsEmptyHint"]</p>
                </div>
            }

            <!-- List health: only lists that need attention, each with a way to act on it -->
            @if (_insights.HasListHealthIssues)
            {
                <h2 class="section-title">@Localizer["ListHealthTitle"]</h2>

                @if (_insights.UnfinishedLists.Count > 0)
                {
                    <section class="health-group">
                        <h3 class="health-group-title">
                            <i class="fa fa-hourglass-half" aria-hidden="true"></i>
                            @Localizer["UnfinishedListsTitle"]
                        </h3>
                        @foreach (var unfinished in _insights.UnfinishedLists)
                        {
                            <div class="health-row" @key="unfinished.Activity.Id">
                                <div class="health-text">
                                    <span class="health-name">@unfinished.Activity.Name</span>
                                    <span class="health-detail">@string.Format(Localizer["ItemsPacked"], unfinished.PackedItems, unfinished.TotalItems)</span>
                                </div>
                                <button class="btn primary btn-sm" @onclick="() => OpenForPacking(unfinished.Activity)">@Localizer["ContinuePacking"]</button>
                            </div>
                        }
                    </section>
                }

                @if (_insights.UnusedLists.Count > 0)
                {
                    <section class="health-group">
                        <h3 class="health-group-title">
                            <i class="fa fa-moon" aria-hidden="true"></i>
                            @Localizer["UnusedListsTitle"]
                        </h3>
                        @foreach (var unused in _insights.UnusedLists)
                        {
                            <div class="health-row" @key="unused.Id">
                                <div class="health-text">
                                    <span class="health-name">@unused.Name</span>
                                    <span class="health-detail">@string.Format(Localizer["LastPackedOn"], FormatDate(unused.LastPacked))</span>
                                </div>
                                <button class="btn cancel btn-sm" @onclick="() => ArchiveAsync(unused)">@Localizer["Archive"]</button>
                            </div>
                        }
                    </section>
                }

                @if (_insights.EmptyLists.Count > 0)
                {
                    <section class="health-group">
                        <h3 class="health-group-title">
                            <i class="fa fa-box-open" aria-hidden="true"></i>
                            @Localizer["EmptyListsTitle"]
                        </h3>
                        @foreach (var empty in _insights.EmptyLists)
                        {
                            <div class="health-row" @key="empty.Id">
                                <div class="health-text">
                                    <button class="health-name link" @onclick="() => OpenForEditing(empty)">@empty.Name</button>
                                </div>
                                <button class="btn danger btn-sm" @onclick="() => DeleteAsync(empty)">@Localizer["Delete"]</button>
                            </div>
                        }
                    </section>
                }

                @if (_insights.SimilarLists.Count > 0)
                {
                    <section class="health-group">
                        <h3 class="health-group-title">
                            <i class="fa fa-clone" aria-hidden="true"></i>
                            @Localizer["SimilarListsTitle"]
                        </h3>
                        @foreach (var similar in _insights.SimilarLists)
                        {
                            <div class="health-row" @key="(similar.First.Id + similar.Second.Id)">
                                <div class="health-text">
                                    <span class="health-name">
                                        <button class="link" @onclick="() => OpenForEditing(similar.First)">@similar.First.Name</button>
                                        &amp;
                                        <button class="link" @onclick="() => OpenForEditing(similar.Second)">@similar.Second.Name</button>
                                    </span>
                                    <span class="health-detail">@string.Format(Localizer["SimilarListsDetail"], similar.SharedPercent)</span>
                                </div>
                            </div>
                        }
                    </section>
                }
            }
            else if (_insights.HasHistory)
            {
                <div class="all-good">
                    <i class="fa fa-check-circle" aria-hidden="true"></i>
                    <span>@Localizer["AllListsHealthy"]</span>
                </div>
            }
        </div>
    }
</div>
