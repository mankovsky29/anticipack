@page "/support"

<div class="page-container with-fixed-navbar">
    <div class="contact-info">
        <h3>@L["ContactUs"]</h3>
        <div class="contact-methods">
            <a href="mailto:@SupportEmail" class="contact-method">
                <i class="fa fa-envelope"></i>
                <div>
                    <strong>@L["Email"]</strong>
                    <span>@SupportEmail</span>
                </div>
            </a>
            <a href="donate" class="contact-method">
                <i class="fa fa-heart"></i>
                <div>
                    <strong>@L["Donate"]</strong>
                    <span>@L["SupportUsDescription"]</span>
                </div>
            </a>
        </div>
    </div>
</div>
