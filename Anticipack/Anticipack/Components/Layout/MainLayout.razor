@using Anticipack.Components.Shared.DialogComponent
@using Anticipack.Components.Shared.ToastComponent
@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        @if (_showStoragePermissionBanner)
        {
            <div class="status-banner warning" role="alert">
                <div class="status-banner-content">
                    <strong>@PermissionBannerTitle</strong>
                    <span>@PermissionBannerMessage</span>
                </div>
                <div class="status-banner-actions">
                    <button class="btn cancel" @onclick="RetryStoragePermissionAsync">@RetryText</button>
                    <button class="btn primary" @onclick="OpenAppSettings">@OpenSettingsText</button>
                </div>
            </div>
        }

        @if (_isOffline)
        {
            <div class="status-banner info" role="status" aria-live="polite">
                <i class="fa fa-cloud" aria-hidden="true"></i>
                <span>@OfflineNotice</span>
            </div>
        }

        <div>
            @Body
        </div>
    </main>
</div>

<Dialog 
    IsVisible="@_dialogVisible"
    Title="@_dialogOptions.Title"
    Message="@_dialogOptions.Message"
    DialogType="@_dialogOptions.DialogType"
    ContentTemplate="@_dialogOptions.ContentTemplate"
    OnClose="HandleDialogClose"
    OnConfirm="HandleDialogConfirm"
    OkText="@_dialogOptions.OkText"
    ConfirmText="@_dialogOptions.ConfirmText"
    CancelText="@_dialogOptions.CancelText"
    ShowCloseButton="@_dialogOptions.ShowCloseButton"
    CloseOnOverlayClick="@_dialogOptions.CloseOnOverlayClick" />

<Toast />
