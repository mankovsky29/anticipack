@using Anticipack.Resources.Localization
@using Anticipack.Components.Shared.NavigationHeaderComponent
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@implements IDisposable

@inject IStringLocalizer<AppResources> L
@inject INavigationHeaderService NavigationHeaderService
@inject IJSRuntime JSRuntime

<div class="nav-container">
    <div class="top-row navbar">
        <div class="container-fluid">
            <button title="@L["NavigationMenu"]" class="navbar-toggler" @onclick="ToggleNavMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <NavigationHeader />
        </div>
    </div>

    <div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
        <div class="desktop-nav-header">
            <NavigationHeader />
        </div>
        <nav class="flex-column">
            <div class="nav-item">
                <NavLink class="nav-link" href="packing-activities">
                    <i class="fa fa-list" aria-hidden="true"></i> @L["PackingActivitiesMenu"]
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="statistics">
                    <i class="fa fa-chart-bar" aria-hidden="true"></i> @L["StatsMenu"]
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="support">
                    <i class="fa fa-comments" aria-hidden="true"></i> @L["SupportMenu"]
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="donate">
                    <i class="fa fa-heart" aria-hidden="true"></i> @L["Donate"]
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="user-settings">
                    <i class="fa fa-cog" aria-hidden="true"></i> @L["SettingsMenu"]
                </NavLink>
            </div>
        </nav>
    </div>
</div>

@code {
    private bool collapseNavMenu = true;

    private string NavMenuCssClass => collapseNavMenu ? "nav-menu-collapsed" : "nav-menu-expanded";

    protected override void OnInitialized()
    {
        NavigationHeaderService.OnNavMenuToggled += UpdateNavMenuState;
        collapseNavMenu = !NavigationHeaderService.IsNavMenuExpanded();
    }

    private async Task ToggleNavMenu()
    {
        var isMobile = await JSRuntime.InvokeAsync<bool>("anticipack.isMobileNavViewport");
        
        if (isMobile)
        {
            collapseNavMenu = !collapseNavMenu;
            
            // Notify the service about the nav menu state
            NavigationHeaderService.SetNavMenuExpanded(!collapseNavMenu);
        }
    }

    private void UpdateNavMenuState(bool isExpanded)
    {
        collapseNavMenu = !isExpanded;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationHeaderService.OnNavMenuToggled -= UpdateNavMenuState;
    }
}
